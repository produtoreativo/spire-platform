tenancy_ocid     = "ocid1.tenancy.oc1..example"
compartment_ocid = "ocid1.compartment.oc1..example"
region           = "sa-saopaulo-1"

environment  = "dev"
project_name = "spire-platform"

vcn_cidr            = "10.20.0.0/16"
public_subnet_cidr  = "10.20.10.0/24"
private_subnet_cidr = "10.20.20.0/24"

kubernetes_version = "v1.31.1"
node_shape         = "VM.Standard.E4.Flex"
node_count         = 2
node_ocpus         = 1
node_memory_in_gbs = 16

# Enable only after reviewing tenancy-specific IAM policy language.
create_iam_policies = false
iam_policy_statements = [
  "Allow service oke to manage all-resources in tenancy where target.compartment.id = 'ocid1.compartment.oc1..example'",
  "Allow any-user to manage repos in tenancy where all {request.principal.type = 'cluster', target.compartment.id = 'ocid1.compartment.oc1..example'}"
]

# Remote state bucket bootstrap. See terraform/README.md before enabling.
create_state_bucket = false
state_bucket_name   = "spire-platform-dev-terraform-state"

freeform_tags = {
  owner = "platform"
}
